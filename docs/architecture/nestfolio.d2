  # =========================================================================
  # C2 — Ledger Domain
  # =========================================================================
  c2-ledger: {
    style: { fill: "#FFFFFF"; stroke: "#FFFFFF" }

    ledger-bff: "Ledger BFF" {
      style: { fill: "#438DD5"; stroke: "#2E6295"; font-color: "#ffffff"; font-size: 34; bold: true; border-radius: 14; stroke-width: 3; shadow: true }
      link: layers.c3-ledger-bff
      tooltip: "Backend-for-frontend that provides a GraphQL API for historical portfolio queries, supporting point-in-time portfolio snapshots, transaction history, and balance lookups."
    }
    ledger-ctrl: "Ledger Controller" {
      style: { fill: "#438DD5"; stroke: "#2E6295"; font-color: "#ffffff"; font-size: 34; bold: true; border-radius: 14; stroke-width: 3; shadow: true }
      link: layers.c3-ledger-ctrl
      tooltip: "The immutable financial ledger that records every transaction, position change, and valuation as append-only entries, serving as the single source of truth for portfolio accounting."
    }
    reconciliation-ctrl: "Reconciliation Controller" {
      style: { fill: "#438DD5"; stroke: "#2E6295"; font-color: "#ffffff"; font-size: 34; bold: true; border-radius: 14; stroke-width: 3; shadow: true }
      link: layers.c3-reconciliation-ctrl
