    ledger-adpt-to-advisory: "3 Events" {style: { fill: "#F5F5F5"; stroke: "#999999"; font-color: "#666666"; font-size: 22; border-radius: 20; stroke-width: 1 }; tooltip: "PORTFOLIO_UPDATED\nPORTFOLIO_DRIFT_DETECTED\nRECONCILIATION_FAILED"}
    ledger-adpt -> ledger-adpt-to-advisory {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
    ledger-adpt-to-advisory -> ext-advisory {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
    ext-execution: "Execution Domain" {style: { fill: "#8B8B8B"; stroke: "#666666"; font-color: "#ffffff"; font-size: 26; border-radius: 10; stroke-width: 1; stroke-dash: 5 }}
    execution-to-ledger-ctrl: "6 Events" {style: { fill: "#F5F5F5"; stroke: "#999999"; font-color: "#666666"; font-size: 22; border-radius: 20; stroke-width: 1 }; tooltip: "ORDER_FILLED\nORDER_PARTIALLY_FILLED\nORDER_REJECTED\nORDER_CANCELLED\nDEPOSIT_DETECTED\nWITHDRAWAL_COMPLETED"}
    ext-execution -> execution-to-ledger-ctrl {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
    execution-to-ledger-ctrl -> ledger-ctrl {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
    execution-to-reconciliation-ctrl: "3 Events" {style: { fill: "#F5F5F5"; stroke: "#999999"; font-color: "#666666"; font-size: 22; border-radius: 20; stroke-width: 1 }; tooltip: "CORPORATE_ACTION_APPLIED\nPORTFOLIO_SNAPSHOT_IMPORTED\nALPACA_ACCOUNT_SNAPSHOT"}
    ext-execution -> execution-to-reconciliation-ctrl {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
    execution-to-reconciliation-ctrl -> reconciliation-ctrl {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}

    layers: {
      c3-ledger-adpt: { ...@./c3/ledger-adpt.d2 }
      c3-ledger-bff: { ...@./c3/ledger-bff.d2 }
      c3-ledger-ctrl: { ...@./c3/ledger-ctrl.d2 }
      c3-reconciliation-ctrl: { ...@./c3/reconciliation-ctrl.d2 }
    }
  }

}
