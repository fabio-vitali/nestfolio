# ===========================================================================
# LAYER: C1 — System Context
# ===========================================================================

# Nestfolio System Boundary
nestfolio: "Nestfolio" {
  class: system

  advisory-domain: "Advisory Domain" {
    class: domain
    link: layers.c2-advisory
  }
  execution-domain: "Execution Domain" {
    class: domain
    link: layers.c2-execution
  }
  investor-domain: "Investor Domain" {
    class: domain
    link: layers.c2-investor
  }
  ledger-domain: "Ledger Domain" {
    class: domain
    link: layers.c2-ledger
  }

  investor-web: "investor-web\n[Angular PWA]" {class: frontend}

  investor-web -> investor-domain {style.font-size: 28}
  investor-domain -> advisory-domain {style.stroke: "#999999"; style.font-size: 28}
  advisory-domain -> execution-domain {style.stroke: "#999999"; style.font-size: 28}
  execution-domain -> ledger-domain {style.stroke: "#999999"; style.font-size: 28}
  ledger-domain -> investor-domain {style.stroke: "#999999"; style.font-size: 28}
}

