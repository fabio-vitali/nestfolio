  # =========================================================================
  # C2 — Execution Domain
  # =========================================================================
  c2-execution: {
    style: { fill: "#FFFFFF"; stroke: "#FFFFFF" }

    broker-ctrl: "Broker Controller" {
      style: { fill: "#438DD5"; stroke: "#2E6295"; font-color: "#ffffff"; font-size: 34; bold: true; border-radius: 14; stroke-width: 3; shadow: true }
      link: layers.c3-broker-ctrl
      tooltip: "Controls broker connections and order routing by managing the active broker session, dispatching orders to the appropriate broker adapter, and handling execution callbacks and circuit breaker logic."
    }
    broker-alpaca-adpt: "Broker Alpaca Adapter" {
      style: { fill: "#438DD5"; stroke: "#2E6295"; font-color: "#ffffff"; font-size: 34; bold: true; border-radius: 14; stroke-width: 3; shadow: true }
      link: layers.c3-broker-alpaca-adpt
      tooltip: "Integrates with the Alpaca brokerage API for live trading, submitting orders, streaming execution updates, and reconciling account positions with the Alpaca platform."
    }
    broker-sim-adpt: "Broker Sim Adapter" {
      style: { fill: "#438DD5"; stroke: "#2E6295"; font-color: "#ffffff"; font-size: 34; bold: true; border-radius: 14; stroke-width: 3; shadow: true }
      link: layers.c3-broker-sim-adpt
      tooltip: "Simulates broker order execution for paper trading, accepting orders and generating realistic fill, reject, and partial-fill events without connecting to a real brokerage."
    }
    execution-ctrl: "Execution Controller" {
      style: { fill: "#438DD5"; stroke: "#2E6295"; font-color: "#ffffff"; font-size: 34; bold: true; border-radius: 14; stroke-width: 3; shadow: true }
      link: layers.c3-execution-ctrl
      tooltip: "Manages the order staging lifecycle by receiving approved decisions, staging orders for market-open execution, and coordinating with broker services for order submission and status tracking."
    }
    execution-adpt: "Execution Adapter" {
      style: { fill: "#438DD5"; stroke: "#2E6295"; font-color: "#ffffff"; font-size: 34; bold: true; border-radius: 14; stroke-width: 3; shadow: true }
      link: layers.c3-execution-adpt
      tooltip: "Routes execution domain events to the investor, ledger, and advisory domains, forwarding order status, deposit and withdrawal completions, and reconciliation signals across domain boundaries."
    }

    ext-investor: "Investor Domain" {style: { fill: "#8B8B8B"; stroke: "#666666"; font-color: "#ffffff"; font-size: 26; border-radius: 10; stroke-width: 1; stroke-dash: 5 }}
    execution-adpt-to-investor: "7 Events" {style: { fill: "#F5F5F5"; stroke: "#999999"; font-color: "#666666"; font-size: 22; border-radius: 20; stroke-width: 1 }; tooltip: "ORDER_STAGED\nORDER_REJECTED\nORDER_CANCELLED\nWITHDRAWAL_REJECTED\nWITHDRAWAL_COMPLETED\nORDER_ESCALATED\nBROKER_CIRCUIT_OPEN"}
    execution-adpt -> execution-adpt-to-investor {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
    execution-adpt-to-investor -> ext-investor {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
    ext-ledger: "Ledger Domain" {style: { fill: "#8B8B8B"; stroke: "#666666"; font-color: "#ffffff"; font-size: 26; border-radius: 10; stroke-width: 1; stroke-dash: 5 }}
    execution-adpt-to-ledger: "9 Events" {style: { fill: "#F5F5F5"; stroke: "#999999"; font-color: "#666666"; font-size: 22; border-radius: 20; stroke-width: 1 }; tooltip: "ORDER_FILLED\nORDER_PARTIALLY_FILLED\nORDER_REJECTED\nORDER_CANCELLED\nDEPOSIT_DETECTED\nWITHDRAWAL_COMPLETED\nCORPORATE_ACTION_APPLIED\nPORTFOLIO_SNAPSHOT_IMPORTED\nALPACA_ACCOUNT_SNAPSHOT"}
    execution-adpt -> execution-adpt-to-ledger {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
    execution-adpt-to-ledger -> ext-ledger {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
    ext-advisory: "Advisory Domain" {style: { fill: "#8B8B8B"; stroke: "#666666"; font-color: "#ffffff"; font-size: 26; border-radius: 10; stroke-width: 1; stroke-dash: 5 }}
    execution-adpt-to-advisory: "8 Events" {style: { fill: "#F5F5F5"; stroke: "#999999"; font-color: "#666666"; font-size: 22; border-radius: 20; stroke-width: 1 }; tooltip: "ORDER_FILLED\nORDER_REJECTED\nORDER_CANCELLED\nDEPOSIT_DETECTED\nPORTFOLIO_DRIFT_DETECTED\nBROKER_SESSION_LOST\nSTREAM_DISCONNECTED\nRECONCILIATION_FAILED"}
    execution-adpt -> execution-adpt-to-advisory {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
    execution-adpt-to-advisory -> ext-advisory {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
    advisory-to-execution-ctrl: "4 Events" {style: { fill: "#F5F5F5"; stroke: "#999999"; font-color: "#666666"; font-size: 22; border-radius: 20; stroke-width: 1 }; tooltip: "DECISION_APPROVED\nUSER_CONFIRMED\nCIRCUIT_BREAKER_TRIGGERED\nCIRCUIT_BREAKER_RESET"}
    ext-advisory -> advisory-to-execution-ctrl {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
    advisory-to-execution-ctrl -> execution-ctrl {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
    investor-to-broker-ctrl: "3 Events" {style: { fill: "#F5F5F5"; stroke: "#999999"; font-color: "#666666"; font-size: 22; border-radius: 20; stroke-width: 1 }; tooltip: "DEPOSIT_INITIATED\nWITHDRAWAL_REQUESTED\nEXECUTION_MODE_CHANGED"}
    ext-investor -> investor-to-broker-ctrl {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
    investor-to-broker-ctrl -> broker-ctrl {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
    investor-to-execution-ctrl: "1 Events" {style: { fill: "#F5F5F5"; stroke: "#999999"; font-color: "#666666"; font-size: 22; border-radius: 20; stroke-width: 1 }; tooltip: "ACCOUNT_CLOSURE_REQUESTED"}
    ext-investor -> investor-to-execution-ctrl {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
    investor-to-execution-ctrl -> execution-ctrl {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
    ext-alpaca: "Alpaca" {style: { fill: "#8B8B8B"; stroke: "#666666"; font-color: "#ffffff"; font-size: 26; border-radius: 10; stroke-width: 1; stroke-dash: 5 }}
    broker-alpaca-adpt -> ext-alpaca {style.stroke-width: 2}
    ext-sim: "Sim" {style: { fill: "#8B8B8B"; stroke: "#666666"; font-color: "#ffffff"; font-size: 26; border-radius: 10; stroke-width: 1; stroke-dash: 5 }}
    broker-sim-adpt -> ext-sim {style.stroke-width: 2}

    layers: {
      c3-broker-alpaca-adpt: { ...@./c3/broker-alpaca-adpt.d2 }
      c3-broker-ctrl: { ...@./c3/broker-ctrl.d2 }
      c3-broker-sim-adpt: { ...@./c3/broker-sim-adpt.d2 }
      c3-execution-adpt: { ...@./c3/execution-adpt.d2 }
      c3-execution-ctrl: { ...@./c3/execution-ctrl.d2 }
    }
  }

  # =========================================================================
  # C2 — Investor Domain
  # =========================================================================
  c2-investor: {
    style: { fill: "#FFFFFF"; stroke: "#FFFFFF" }

    investor-web: "Investor Web" {
      style: { fill: "#438DD5"; stroke: "#2E6295"; font-color: "#ffffff"; font-size: 34; bold: true; border-radius: 14; stroke-width: 3; shadow: true }
      link: layers.c3-investor-web
      tooltip: "The investor-facing single-page application, an Angular PWA served via CDN with Cognito authentication that provides the UI for portfolio management, onboarding, and advisory interactions."
    }
    dashboard-bff: "Dashboard BFF" {
      style: { fill: "#438DD5"; stroke: "#2E6295"; font-color: "#ffffff"; font-size: 34; bold: true; border-radius: 14; stroke-width: 3; shadow: true }
      link: layers.c3-dashboard-bff
      tooltip: "Provides a read-optimized GraphQL API for the investor dashboard, aggregating portfolio performance, recent activity, and advisory status into dashboard-ready views."
    }
    investor-bff: "Investor BFF" {
      style: { fill: "#438DD5"; stroke: "#2E6295"; font-color: "#ffffff"; font-size: 34; bold: true; border-radius: 14; stroke-width: 3; shadow: true }
      link: layers.c3-investor-bff
      tooltip: "Backend-for-frontend that provides a GraphQL API for the investor domain, serving portfolio summaries, account balances, and investor profile data to the investor-facing application."
    }
    investor-ctrl: "Investor Controller" {
      style: { fill: "#438DD5"; stroke: "#2E6295"; font-color: "#ffffff"; font-size: 34; bold: true; border-radius: 14; stroke-width: 3; shadow: true }
      link: layers.c3-investor-ctrl
      tooltip: "Manages investor state by processing profile updates, risk tolerance changes, mandate grants, and operating mode transitions, maintaining the canonical investor record."
    }
