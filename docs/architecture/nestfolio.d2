# ===========================================================================
# LAYER: C1 — System Context
# ===========================================================================

# System Boundary
nestfolio: "" {
  style: { fill: "#FFFFFF"; stroke: "#FFFFFF" }

  web-app: "Nestfolio Web App" {
    class: frontend
  }

  advisory-domain: "Advisory Domain" {
    class: domain
    link: layers.c2-advisory
    tooltip: "The Advisory domain generates and manages investment recommendations. It orchestrates market intelligence gathering, portfolio analysis, compliance checking, and decision workflows to produce actionable investment advice tailored to each investor's profile and goals. Each recommendation includes a plain-language explanation of the reasoning behind it, so investors understand why a specific action was proposed."
  }
  execution-domain: "Execution Domain" {
    class: domain
    link: layers.c2-execution
    tooltip: "The Execution domain handles the lifecycle of trade orders. It translates advisory recommendations into broker-ready orders, manages order execution through broker integrations, tracks order status, and ensures reliable settlement reporting."
  }
  investor-domain: "Investor Domain" {
    class: domain
    link: layers.c2-investor
    tooltip: "The Investor domain manages investor profiles, preferences, and the investor-facing experience. It handles onboarding new investors, maintaining their risk tolerances and financial goals, and providing dashboards for portfolio visibility and account management."
  }
  ledger-domain: "Ledger Domain" {
    class: domain
    link: layers.c2-ledger
    tooltip: "The Ledger domain maintains the authoritative record of all portfolio positions, transactions, and valuations. It reconciles broker-reported activity with internal records and provides the financial source of truth for the entire platform."
  }

  investor-to-advisory: "4 Events" {
    class: flow-label
    tooltip: "INVESTOR_PROFILE_UPDATED\nMANDATE_ISSUED\nMANDATE_REVOKED\nOPERATING_MODE_CHANGED"
  }
  investor-domain -> investor-to-advisory {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
  investor-to-advisory -> advisory-domain {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
  execution-to-advisory: "4 Events" {
    class: flow-label
    tooltip: "ORDER_FILLED\nORDER_REJECTED\nORDER_CANCELLED\nDEPOSIT_DETECTED"
  }
  execution-domain -> execution-to-advisory {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
  execution-to-advisory -> advisory-domain {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
  ledger-to-advisory: "2 Events" {
    class: flow-label
    tooltip: "PORTFOLIO_UPDATED\nPORTFOLIO_DRIFT_DETECTED"
  }
  ledger-domain -> ledger-to-advisory {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
  ledger-to-advisory -> advisory-domain {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
  advisory-to-execution: "2 Events" {
    class: flow-label
    tooltip: "DECISION_APPROVED\nUSER_CONFIRMED"
  }
  advisory-domain -> advisory-to-execution {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
  advisory-to-execution -> execution-domain {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
  investor-to-execution: "4 Events" {
    class: flow-label
    tooltip: "DEPOSIT_INITIATED\nWITHDRAWAL_REQUESTED\nACCOUNT_CLOSURE_REQUESTED\nEXECUTION_MODE_CHANGED"
  }
  investor-domain -> investor-to-execution {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
  investor-to-execution -> execution-domain {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
  advisory-to-investor: "8 Events" {
    class: flow-label
    tooltip: "DECISION_PACKET_CREATED\nUSER_CONFIRMATION_REQUESTED\nEXPLANATION_GENERATED\nDECISION_APPROVED\nDECISION_BLOCKED\nESCALATION_TRIGGERED\nINCIDENT_DETECTED\nINCIDENT_RESOLVED"
  }
  advisory-domain -> advisory-to-investor {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
  advisory-to-investor -> investor-domain {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
  execution-to-investor: "11 Events" {
    class: flow-label
    tooltip: "ORDER_STAGED\nORDER_FILLED\nORDER_REJECTED\nORDER_CANCELLED\nDEPOSIT_DETECTED\nWITHDRAWAL_COMPLETED\nORDER_ESCALATED\nBROKER_CIRCUIT_OPEN\nBROKER_CIRCUIT_CLOSED\nBROKER_HEAL_ESCALATED\nTRANSFER_FAILED"
  }
  execution-domain -> execution-to-investor {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
  execution-to-investor -> investor-domain {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
  ledger-to-investor: "6 Events" {
    class: flow-label
    tooltip: "BALANCE_UPDATED\nPORTFOLIO_UPDATED\nLEDGER_ENTRY_RECORDED\nRECONCILIATION_COMPLETED\nLEDGER_PROCESSING_FAILED\nPORTFOLIO_DRIFT_DETECTED"
  }
  ledger-domain -> ledger-to-investor {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
  ledger-to-investor -> investor-domain {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
  execution-to-ledger: "10 Events" {
    class: flow-label
    tooltip: "ORDER_FILLED\nORDER_PARTIALLY_FILLED\nORDER_REJECTED\nORDER_CANCELLED\nDEPOSIT_DETECTED\nWITHDRAWAL_COMPLETED\nTRANSFER_FAILED\nCORPORATE_ACTION_APPLIED\nPORTFOLIO_SNAPSHOT_IMPORTED\nALPACA_ACCOUNT_SNAPSHOT"
  }
  execution-domain -> execution-to-ledger {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
  execution-to-ledger -> ledger-domain {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
  advisory-to-ledger: "1 Events" {
    class: flow-label
    tooltip: "DECISION_PACKET_CREATED"
  }
  advisory-domain -> advisory-to-ledger {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
  advisory-to-ledger -> ledger-domain {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
}

investor-user: "Investor User" {class: person}
investor-user -> nestfolio.web-app {style.stroke-width: 3}
nestfolio.web-app -> nestfolio.advisory-domain {style.stroke-width: 2; style.stroke: "#4CAF50"}
nestfolio.web-app -> nestfolio.investor-domain {style.stroke-width: 2; style.stroke: "#4CAF50"}
nestfolio.web-app -> nestfolio.ledger-domain {style.stroke-width: 2; style.stroke: "#4CAF50"}

# ===========================================================================
# LAYERS
# ===========================================================================
layers: {

  # =========================================================================
  # C2 — Advisory Domain
  # =========================================================================
  c2-advisory: {
    style: { fill: "#FFFFFF"; stroke: "#FFFFFF" }

    advisory-bff: "Advisory\nBFF" {
      style: { fill: "#438DD5"; stroke: "#2E6295"; font-color: "#ffffff"; font-size: 34; bold: true; border-radius: 14; stroke-width: 3; shadow: true }
      link: layers.c3-advisory-bff
      tooltip: "Backend-for-frontend that provides a GraphQL API for the advisory domain, serving decision read models, recommendations, and advisory status to the investor-facing application."
    }
    advisory-narrative-ctrl: "Advisory Narrative\nCTRL" {
      style: { fill: "#438DD5"; stroke: "#2E6295"; font-color: "#ffffff"; font-size: 34; bold: true; border-radius: 14; stroke-width: 3; shadow: true }
      link: layers.c3-advisory-narrative-ctrl
      tooltip: "Generates plain-language explanations of advisory decisions using a knowledge base of regulatory and financial concepts. It produces investor-friendly narratives that explain why specific recommendations were made."
    }
    compliance-ctrl: "Compliance\nCTRL" {
      style: { fill: "#438DD5"; stroke: "#2E6295"; font-color: "#ffffff"; font-size: 34; bold: true; border-radius: 14; stroke-width: 3; shadow: true }
      link: layers.c3-compliance-ctrl
      tooltip: "Validates advisory decisions against regulatory and mandate constraints, checking that proposed trades comply with investor mandates, concentration limits, and regulatory requirements before execution."
    }
    decision-workflow-ctrl: "Decision Workflow\nCTRL" {
      style: { fill: "#438DD5"; stroke: "#2E6295"; font-color: "#ffffff"; font-size: 34; bold: true; border-radius: 14; stroke-width: 3; shadow: true }
      link: layers.c3-decision-workflow-ctrl
      tooltip: "Orchestrates the multi-step advisory decision cycle by coordinating parallel AI agents for portfolio analysis, market intelligence, compliance checking, and allocation through a state machine. It aggregates their outputs into a decision packet and learns investor preferences over time."
    }
    investor-profile-ctrl: "Investor Profile\nCTRL" {
      style: { fill: "#438DD5"; stroke: "#2E6295"; font-color: "#ffffff"; font-size: 34; bold: true; border-radius: 14; stroke-width: 3; shadow: true }
      link: layers.c3-investor-profile-ctrl
      tooltip: "Maintains enriched investor profiles for advisory decisions by combining regulatory suitability data with behavioral signals. It builds a comprehensive understanding of each investor's risk tolerance, goals, and preferences."
    }
    market-intelligence-ctrl: "Market Intelligence\nCTRL" {
      style: { fill: "#438DD5"; stroke: "#2E6295"; font-color: "#ffffff"; font-size: 34; bold: true; border-radius: 14; stroke-width: 3; shadow: true }
      link: layers.c3-market-intelligence-ctrl
      tooltip: "Monitors and analyzes market conditions by aggregating signals from multiple data sources including economic indicators, news, filings, and prices. It assesses market sentiment and identifies conditions relevant to portfolio decisions."
    }
    portfolio-engine-ctrl: "Portfolio Engine\nCTRL" {
      style: { fill: "#438DD5"; stroke: "#2E6295"; font-color: "#ffffff"; font-size: 34; bold: true; border-radius: 14; stroke-width: 3; shadow: true }
      link: layers.c3-portfolio-engine-ctrl
      tooltip: "Analyzes portfolio composition and fund characteristics, evaluating holdings against target allocations and screening the investment universe for rebalancing candidates. It provides portfolio analytics to the decision workflow."
    }
    alpha-vantage-adpt: "Alpha Vantage\nADPT" {
      style: { fill: "#438DD5"; stroke: "#2E6295"; font-color: "#ffffff"; font-size: 34; bold: true; border-radius: 14; stroke-width: 3; shadow: true }
      link: layers.c3-alpha-vantage-adpt
      tooltip: "Fetches economic indicators and market articles from the Alpha Vantage API on a scheduled basis, normalizing them into domain events for consumption by the market intelligence pipeline."
    }
    fred-adpt: "Fred\nADPT" {
      style: { fill: "#438DD5"; stroke: "#2E6295"; font-color: "#ffffff"; font-size: 34; bold: true; border-radius: 14; stroke-width: 3; shadow: true }
      link: layers.c3-fred-adpt
      tooltip: "Fetches Federal Reserve economic data including interest rates, inflation, and employment figures on a scheduled basis, normalizing them into domain events for the market intelligence pipeline."
    }
    marketwatch-adpt: "Marketwatch\nADPT" {
      style: { fill: "#438DD5"; stroke: "#2E6295"; font-color: "#ffffff"; font-size: 34; bold: true; border-radius: 14; stroke-width: 3; shadow: true }
      link: layers.c3-marketwatch-adpt
      tooltip: "Ingests market commentary and news summaries, normalizing editorial content into domain events for market sentiment analysis."
    }
    sec-edgar-adpt: "Sec Edgar\nADPT" {
      style: { fill: "#438DD5"; stroke: "#2E6295"; font-color: "#ffffff"; font-size: 34; bold: true; border-radius: 14; stroke-width: 3; shadow: true }
      link: layers.c3-sec-edgar-adpt
      tooltip: "Ingests SEC filing data for funds and companies, normalizing regulatory disclosures into domain events for compliance and market intelligence analysis."
    }
    yahoo-finance-adpt: "Yahoo Finance\nADPT" {
      style: { fill: "#438DD5"; stroke: "#2E6295"; font-color: "#ffffff"; font-size: 34; bold: true; border-radius: 14; stroke-width: 3; shadow: true }
      link: layers.c3-yahoo-finance-adpt
      tooltip: "Fetches real-time price quotes and dividend data, normalizing market prices into domain events for portfolio valuation and drift detection."
    }
    advisory-adpt: "Advisory\nADPT" {
      style: { fill: "#438DD5"; stroke: "#2E6295"; font-color: "#ffffff"; font-size: 34; bold: true; border-radius: 14; stroke-width: 3; shadow: true }
      link: layers.c3-advisory-adpt
      tooltip: "Ingests cross-domain events from the investor, execution, and ledger buses into the advisory domain bus, subscribing to goal updates, mandate changes, order status, portfolio updates, and reconciliation signals."
    }

