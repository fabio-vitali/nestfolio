    yahoo-finance-adpt -> ext-finance {style.stroke-width: 2}

    layers: {
      c3-advisory-adpt: { ...@./c3/advisory-adpt.d2 }
      c3-advisory-bff: { ...@./c3/advisory-bff.d2 }
      c3-advisory-narrative-ctrl: { ...@./c3/advisory-narrative-ctrl.d2 }
      c3-alpha-vantage-adpt: { ...@./c3/alpha-vantage-adpt.d2 }
      c3-compliance-ctrl: { ...@./c3/compliance-ctrl.d2 }
      c3-decision-workflow-ctrl: { ...@./c3/decision-workflow-ctrl.d2 }
      c3-fred-adpt: { ...@./c3/fred-adpt.d2 }
      c3-investor-profile-ctrl: { ...@./c3/investor-profile-ctrl.d2 }
      c3-market-intelligence-ctrl: { ...@./c3/market-intelligence-ctrl.d2 }
      c3-marketwatch-adpt: { ...@./c3/marketwatch-adpt.d2 }
      c3-portfolio-engine-ctrl: { ...@./c3/portfolio-engine-ctrl.d2 }
      c3-sec-edgar-adpt: { ...@./c3/sec-edgar-adpt.d2 }
      c3-yahoo-finance-adpt: { ...@./c3/yahoo-finance-adpt.d2 }
    }
  }

  # =========================================================================
  # C2 — Execution Domain
  # =========================================================================
  c2-execution: {
    style: { fill: "#FFFFFF"; stroke: "#FFFFFF" }

    broker-ctrl: "Broker\nCTRL" {
      style: { fill: "#438DD5"; stroke: "#2E6295"; font-color: "#ffffff"; font-size: 34; bold: true; border-radius: 14; stroke-width: 3; shadow: true }
      link: layers.c3-broker-ctrl
      tooltip: "Controls broker connections and order routing by managing the active broker session, dispatching orders to the appropriate broker adapter, and handling execution callbacks and circuit breaker logic."
    }
    broker-alpaca-adpt: "Broker Alpaca\nADPT" {
      style: { fill: "#438DD5"; stroke: "#2E6295"; font-color: "#ffffff"; font-size: 34; bold: true; border-radius: 14; stroke-width: 3; shadow: true }
      link: layers.c3-broker-alpaca-adpt
      tooltip: "Integrates with the Alpaca brokerage API for live trading, submitting orders, streaming execution updates, and reconciling account positions with the Alpaca platform."
    }
    broker-sim-adpt: "Broker Sim\nADPT" {
      style: { fill: "#438DD5"; stroke: "#2E6295"; font-color: "#ffffff"; font-size: 34; bold: true; border-radius: 14; stroke-width: 3; shadow: true }
      link: layers.c3-broker-sim-adpt
      tooltip: "Simulates broker order execution for paper trading, accepting orders and generating realistic fill, reject, and partial-fill events without connecting to a real brokerage."
    }
    execution-ctrl: "Execution\nCTRL" {
      style: { fill: "#438DD5"; stroke: "#2E6295"; font-color: "#ffffff"; font-size: 34; bold: true; border-radius: 14; stroke-width: 3; shadow: true }
      link: layers.c3-execution-ctrl
      tooltip: "Manages the order staging lifecycle by receiving approved decisions, staging orders for market-open execution, and coordinating with broker services for order submission and status tracking."
    }
    execution-adpt: "Execution\nADPT" {
      style: { fill: "#438DD5"; stroke: "#2E6295"; font-color: "#ffffff"; font-size: 34; bold: true; border-radius: 14; stroke-width: 3; shadow: true }
      link: layers.c3-execution-adpt
      tooltip: "Ingests cross-domain events from the advisory and investor buses into the execution domain bus, subscribing to decision approvals, circuit breaker signals, deposit and withdrawal requests."
    }

    ext-advisory: "Advisory Domain" {style: { fill: "#8B8B8B"; stroke: "#666666"; font-color: "#ffffff"; font-size: 26; border-radius: 10; stroke-width: 1; stroke-dash: 5 }}
    advisory-to-execution-adpt: "2 Events" {style: { fill: "#F5F5F5"; stroke: "#999999"; font-color: "#666666"; font-size: 22; border-radius: 20; stroke-width: 1 }; tooltip: "DECISION_APPROVED\nUSER_CONFIRMED"}
    ext-advisory -> advisory-to-execution-adpt {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
    advisory-to-execution-adpt -> execution-adpt {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
    ext-investor: "Investor Domain" {style: { fill: "#8B8B8B"; stroke: "#666666"; font-color: "#ffffff"; font-size: 26; border-radius: 10; stroke-width: 1; stroke-dash: 5 }}
    investor-to-execution-adpt: "4 Events" {style: { fill: "#F5F5F5"; stroke: "#999999"; font-color: "#666666"; font-size: 22; border-radius: 20; stroke-width: 1 }; tooltip: "DEPOSIT_INITIATED\nWITHDRAWAL_REQUESTED\nACCOUNT_CLOSURE_REQUESTED\nEXECUTION_MODE_CHANGED"}
    ext-investor -> investor-to-execution-adpt {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
    investor-to-execution-adpt -> execution-adpt {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
    execution-adpt-to-broker-ctrl: "3 Events" {style: { fill: "#F5F5F5"; stroke: "#999999"; font-color: "#666666"; font-size: 22; border-radius: 20; stroke-width: 1 }; tooltip: "DEPOSIT_INITIATED\nWITHDRAWAL_REQUESTED\nEXECUTION_MODE_CHANGED"}
    execution-adpt -> execution-adpt-to-broker-ctrl {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
    execution-adpt-to-broker-ctrl -> broker-ctrl {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
    execution-adpt-to-execution-ctrl: "3 Events" {style: { fill: "#F5F5F5"; stroke: "#999999"; font-color: "#666666"; font-size: 22; border-radius: 20; stroke-width: 1 }; tooltip: "DECISION_APPROVED\nUSER_CONFIRMED\nACCOUNT_CLOSURE_REQUESTED"}
    execution-adpt -> execution-adpt-to-execution-ctrl {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
    execution-adpt-to-execution-ctrl -> execution-ctrl {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
    ext-alpaca: "Alpaca" {style: { fill: "#8B8B8B"; stroke: "#666666"; font-color: "#ffffff"; font-size: 26; border-radius: 10; stroke-width: 1; stroke-dash: 5 }}
    broker-alpaca-adpt -> ext-alpaca {style.stroke-width: 2}
    ext-sim: "Sim" {style: { fill: "#8B8B8B"; stroke: "#666666"; font-color: "#ffffff"; font-size: 26; border-radius: 10; stroke-width: 1; stroke-dash: 5 }}
    broker-sim-adpt -> ext-sim {style.stroke-width: 2}

    layers: {
      c3-broker-alpaca-adpt: { ...@./c3/broker-alpaca-adpt.d2 }
      c3-broker-ctrl: { ...@./c3/broker-ctrl.d2 }
      c3-broker-sim-adpt: { ...@./c3/broker-sim-adpt.d2 }
      c3-execution-adpt: { ...@./c3/execution-adpt.d2 }
      c3-execution-ctrl: { ...@./c3/execution-ctrl.d2 }
    }
  }

  # =========================================================================
  # C2 — Investor Domain
  # =========================================================================
  c2-investor: {
    style: { fill: "#FFFFFF"; stroke: "#FFFFFF" }

    dashboard-bff: "Dashboard\nBFF" {
      style: { fill: "#438DD5"; stroke: "#2E6295"; font-color: "#ffffff"; font-size: 34; bold: true; border-radius: 14; stroke-width: 3; shadow: true }
      link: layers.c3-dashboard-bff
      tooltip: "Provides a read-optimized GraphQL API for the investor dashboard, aggregating portfolio performance, recent activity, and advisory status into dashboard-ready views."
    }
    investor-bff: "Investor\nBFF" {
      style: { fill: "#438DD5"; stroke: "#2E6295"; font-color: "#ffffff"; font-size: 34; bold: true; border-radius: 14; stroke-width: 3; shadow: true }
      link: layers.c3-investor-bff
      tooltip: "Backend-for-frontend that provides a GraphQL API for the investor domain, serving portfolio summaries, account balances, and investor profile data to the investor-facing application."
    }
    investor-ctrl: "Investor\nCTRL" {
      style: { fill: "#438DD5"; stroke: "#2E6295"; font-color: "#ffffff"; font-size: 34; bold: true; border-radius: 14; stroke-width: 3; shadow: true }
      link: layers.c3-investor-ctrl
      tooltip: "Manages investor state by processing profile updates, risk tolerance changes, mandate grants, and operating mode transitions, maintaining the canonical investor record."
    }
    onboarding-bff: "Onboarding\nBFF" {
      style: { fill: "#438DD5"; stroke: "#2E6295"; font-color: "#ffffff"; font-size: 34; bold: true; border-radius: 14; stroke-width: 3; shadow: true }
      link: layers.c3-onboarding-bff
      tooltip: "Guides new investors through the onboarding process using a conversational AI agent with a regulatory knowledge base to collect suitability information, risk preferences, and account details across a multi-phase wizard."
    }
    investor-adpt: "Investor\nADPT" {
      style: { fill: "#438DD5"; stroke: "#2E6295"; font-color: "#ffffff"; font-size: 34; bold: true; border-radius: 14; stroke-width: 3; shadow: true }
      link: layers.c3-investor-adpt
      tooltip: "Ingests cross-domain events from the advisory, execution, and ledger buses into the investor domain bus, subscribing to decision packets, order status, balance updates, and reconciliation signals."
    }

    onboarding-mfe: "Onboarding\nMFE" {
      class: frontend
    }
    onboarding-mfe -> onboarding-bff: "GraphQL" {style.stroke: "#4CAF50"; style.stroke-width: 2}
    investor-mfe: "Investor\nMFE" {
      class: frontend
    }
    investor-mfe -> investor-bff: "GraphQL" {style.stroke: "#4CAF50"; style.stroke-width: 2}
    dashboard-mfe: "Dashboard\nMFE" {
      class: frontend
    }
    dashboard-mfe -> dashboard-bff: "GraphQL" {style.stroke: "#4CAF50"; style.stroke-width: 2}

    ext-advisory: "Advisory Domain" {style: { fill: "#8B8B8B"; stroke: "#666666"; font-color: "#ffffff"; font-size: 26; border-radius: 10; stroke-width: 1; stroke-dash: 5 }}
    advisory-to-investor-adpt: "8 Events" {style: { fill: "#F5F5F5"; stroke: "#999999"; font-color: "#666666"; font-size: 22; border-radius: 20; stroke-width: 1 }; tooltip: "DECISION_PACKET_CREATED\nUSER_CONFIRMATION_REQUESTED\nEXPLANATION_GENERATED\nDECISION_APPROVED\nDECISION_BLOCKED\nESCALATION_TRIGGERED\nINCIDENT_DETECTED\nINCIDENT_RESOLVED"}
    ext-advisory -> advisory-to-investor-adpt {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
    advisory-to-investor-adpt -> investor-adpt {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
    ext-execution: "Execution Domain" {style: { fill: "#8B8B8B"; stroke: "#666666"; font-color: "#ffffff"; font-size: 26; border-radius: 10; stroke-width: 1; stroke-dash: 5 }}
    execution-to-investor-adpt: "11 Events" {style: { fill: "#F5F5F5"; stroke: "#999999"; font-color: "#666666"; font-size: 22; border-radius: 20; stroke-width: 1 }; tooltip: "ORDER_STAGED\nORDER_FILLED\nORDER_REJECTED\nORDER_CANCELLED\nDEPOSIT_DETECTED\nWITHDRAWAL_COMPLETED\nORDER_ESCALATED\nBROKER_CIRCUIT_OPEN\nBROKER_CIRCUIT_CLOSED\nBROKER_HEAL_ESCALATED\nTRANSFER_FAILED"}
    ext-execution -> execution-to-investor-adpt {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
    execution-to-investor-adpt -> investor-adpt {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
    ext-ledger: "Ledger Domain" {style: { fill: "#8B8B8B"; stroke: "#666666"; font-color: "#ffffff"; font-size: 26; border-radius: 10; stroke-width: 1; stroke-dash: 5 }}
    ledger-to-investor-adpt: "6 Events" {style: { fill: "#F5F5F5"; stroke: "#999999"; font-color: "#666666"; font-size: 22; border-radius: 20; stroke-width: 1 }; tooltip: "BALANCE_UPDATED\nPORTFOLIO_UPDATED\nLEDGER_ENTRY_RECORDED\nRECONCILIATION_COMPLETED\nLEDGER_PROCESSING_FAILED\nPORTFOLIO_DRIFT_DETECTED"}
    ext-ledger -> ledger-to-investor-adpt {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
    ledger-to-investor-adpt -> investor-adpt {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
    investor-adpt-to-dashboard-bff: "14 Events" {style: { fill: "#F5F5F5"; stroke: "#999999"; font-color: "#666666"; font-size: 22; border-radius: 20; stroke-width: 1 }; tooltip: "DECISION_PACKET_CREATED\nUSER_CONFIRMATION_REQUESTED\nDECISION_APPROVED\nDECISION_BLOCKED\nORDER_FILLED\nORDER_REJECTED\nORDER_CANCELLED\nDEPOSIT_DETECTED\nWITHDRAWAL_COMPLETED\nBALANCE_UPDATED\nPORTFOLIO_UPDATED\nLEDGER_ENTRY_RECORDED\nRECONCILIATION_COMPLETED\nPORTFOLIO_DRIFT_DETECTED"}
    investor-adpt -> investor-adpt-to-dashboard-bff {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
    investor-adpt-to-dashboard-bff -> dashboard-bff {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
    investor-adpt-to-investor-bff: "4 Events" {style: { fill: "#F5F5F5"; stroke: "#999999"; font-color: "#666666"; font-size: 22; border-radius: 20; stroke-width: 1 }; tooltip: "DEPOSIT_DETECTED\nBROKER_CIRCUIT_OPEN\nBROKER_CIRCUIT_CLOSED\nBALANCE_UPDATED"}
    investor-adpt -> investor-adpt-to-investor-bff {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
    investor-adpt-to-investor-bff -> investor-bff {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
    investor-adpt-to-investor-ctrl: "9 Events" {style: { fill: "#F5F5F5"; stroke: "#999999"; font-color: "#666666"; font-size: 22; border-radius: 20; stroke-width: 1 }; tooltip: "DECISION_APPROVED\nDECISION_BLOCKED\nORDER_FILLED\nORDER_REJECTED\nWITHDRAWAL_COMPLETED\nBROKER_CIRCUIT_OPEN\nBROKER_CIRCUIT_CLOSED\nBROKER_HEAL_ESCALATED\nBALANCE_UPDATED"}
    investor-adpt -> investor-adpt-to-investor-ctrl {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
    investor-adpt-to-investor-ctrl -> investor-ctrl {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}

    layers: {
      c3-dashboard-bff: { ...@./c3/dashboard-bff.d2 }
      c3-investor-adpt: { ...@./c3/investor-adpt.d2 }
      c3-investor-bff: { ...@./c3/investor-bff.d2 }
      c3-investor-ctrl: { ...@./c3/investor-ctrl.d2 }
      c3-onboarding-bff: { ...@./c3/onboarding-bff.d2 }
    }
  }

  # =========================================================================
  # C2 — Ledger Domain
  # =========================================================================
  c2-ledger: {
    style: { fill: "#FFFFFF"; stroke: "#FFFFFF" }

    ledger-bff: "Ledger\nBFF" {
      style: { fill: "#438DD5"; stroke: "#2E6295"; font-color: "#ffffff"; font-size: 34; bold: true; border-radius: 14; stroke-width: 3; shadow: true }
      link: layers.c3-ledger-bff
      tooltip: "Backend-for-frontend that provides a GraphQL API for historical portfolio queries, supporting point-in-time portfolio snapshots, transaction history, and balance lookups."
    }
    ledger-ctrl: "Ledger\nCTRL" {
      style: { fill: "#438DD5"; stroke: "#2E6295"; font-color: "#ffffff"; font-size: 34; bold: true; border-radius: 14; stroke-width: 3; shadow: true }
      link: layers.c3-ledger-ctrl
      tooltip: "The immutable financial ledger that records every transaction, position change, and valuation as append-only entries, serving as the single source of truth for portfolio accounting."
    }
    reconciliation-ctrl: "Reconciliation\nCTRL" {
      style: { fill: "#438DD5"; stroke: "#2E6295"; font-color: "#ffffff"; font-size: 34; bold: true; border-radius: 14; stroke-width: 3; shadow: true }
      link: layers.c3-reconciliation-ctrl
      tooltip: "Reconciles broker-reported positions and transactions against the internal ledger, detecting discrepancies, flagging mismatches, and emitting reconciliation status events for cross-domain visibility."
    }
    ledger-adpt: "Ledger\nADPT" {
      style: { fill: "#438DD5"; stroke: "#2E6295"; font-color: "#ffffff"; font-size: 34; bold: true; border-radius: 14; stroke-width: 3; shadow: true }
      link: layers.c3-ledger-adpt
      tooltip: "Ingests cross-domain events from the execution bus into the ledger domain bus, subscribing to order fills, deposit and withdrawal completions, corporate actions, and portfolio snapshots."
    }

    ledger-mfe: "Ledger\nMFE" {
      class: frontend
    }
    ledger-mfe -> ledger-bff: "GraphQL" {style.stroke: "#4CAF50"; style.stroke-width: 2}

    ext-execution: "Execution Domain" {style: { fill: "#8B8B8B"; stroke: "#666666"; font-color: "#ffffff"; font-size: 26; border-radius: 10; stroke-width: 1; stroke-dash: 5 }}
    execution-to-ledger-adpt: "10 Events" {style: { fill: "#F5F5F5"; stroke: "#999999"; font-color: "#666666"; font-size: 22; border-radius: 20; stroke-width: 1 }; tooltip: "ORDER_FILLED\nORDER_PARTIALLY_FILLED\nORDER_REJECTED\nORDER_CANCELLED\nDEPOSIT_DETECTED\nWITHDRAWAL_COMPLETED\nTRANSFER_FAILED\nCORPORATE_ACTION_APPLIED\nPORTFOLIO_SNAPSHOT_IMPORTED\nALPACA_ACCOUNT_SNAPSHOT"}
    ext-execution -> execution-to-ledger-adpt {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
    execution-to-ledger-adpt -> ledger-adpt {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
    ext-advisory: "Advisory Domain" {style: { fill: "#8B8B8B"; stroke: "#666666"; font-color: "#ffffff"; font-size: 26; border-radius: 10; stroke-width: 1; stroke-dash: 5 }}
    advisory-to-ledger-adpt: "1 Events" {style: { fill: "#F5F5F5"; stroke: "#999999"; font-color: "#666666"; font-size: 22; border-radius: 20; stroke-width: 1 }; tooltip: "DECISION_PACKET_CREATED"}
    ext-advisory -> advisory-to-ledger-adpt {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
    advisory-to-ledger-adpt -> ledger-adpt {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
    ledger-adpt-to-ledger-ctrl: "8 Events" {style: { fill: "#F5F5F5"; stroke: "#999999"; font-color: "#666666"; font-size: 22; border-radius: 20; stroke-width: 1 }; tooltip: "ORDER_FILLED\nORDER_PARTIALLY_FILLED\nORDER_REJECTED\nORDER_CANCELLED\nDEPOSIT_DETECTED\nWITHDRAWAL_COMPLETED\nCORPORATE_ACTION_APPLIED\nDECISION_PACKET_CREATED"}
    ledger-adpt -> ledger-adpt-to-ledger-ctrl {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
    ledger-adpt-to-ledger-ctrl -> ledger-ctrl {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
    ledger-adpt-to-reconciliation-ctrl: "3 Events" {style: { fill: "#F5F5F5"; stroke: "#999999"; font-color: "#666666"; font-size: 22; border-radius: 20; stroke-width: 1 }; tooltip: "CORPORATE_ACTION_APPLIED\nPORTFOLIO_SNAPSHOT_IMPORTED\nALPACA_ACCOUNT_SNAPSHOT"}
    ledger-adpt -> ledger-adpt-to-reconciliation-ctrl {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}
    ledger-adpt-to-reconciliation-ctrl -> reconciliation-ctrl {style.stroke: "#999999"; style.stroke-width: 3; style.stroke-dash: 3}

    layers: {
      c3-ledger-adpt: { ...@./c3/ledger-adpt.d2 }
      c3-ledger-bff: { ...@./c3/ledger-bff.d2 }
      c3-ledger-ctrl: { ...@./c3/ledger-ctrl.d2 }
      c3-reconciliation-ctrl: { ...@./c3/reconciliation-ctrl.d2 }
    }
  }

}
