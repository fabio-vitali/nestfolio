layers: {

  # =========================================================================
  # C2 — Advisory Domain
  # =========================================================================
  c2-advisory: {
    style: { fill: "#FFFFFF"; stroke: "#FFFFFF" }

    advisory-bff: "Advisory BFF" {
      style: { fill: "#438DD5"; stroke: "#2E6295"; font-color: "#ffffff"; font-size: 34; bold: true; border-radius: 14; stroke-width: 3; shadow: true }
      link: layers.c3-advisory-bff
      tooltip: "Backend-for-frontend that provides a GraphQL API for the advisory domain, serving decision read models, recommendations, and advisory status to the investor-facing application."
    }
    advisory-ctrl: "Advisory Controller" {
      style: { fill: "#438DD5"; stroke: "#2E6295"; font-color: "#ffffff"; font-size: 34; bold: true; border-radius: 14; stroke-width: 3; shadow: true }
      link: layers.c3-advisory-ctrl
      tooltip: "Core decision lifecycle orchestrator that evaluates portfolios against market conditions and investor profiles to determine if rebalancing is needed. It uses AI tools for portfolio analysis, market assessment, and universe screening to drive the advisory decision cycle."
    }
    advisory-narrative-ctrl: "Advisory Narrative Controller" {
      style: { fill: "#438DD5"; stroke: "#2E6295"; font-color: "#ffffff"; font-size: 34; bold: true; border-radius: 14; stroke-width: 3; shadow: true }
      link: layers.c3-advisory-narrative-ctrl
      tooltip: "Generates plain-language explanations of advisory decisions using a knowledge base of regulatory and financial concepts. It produces investor-friendly narratives that explain why specific recommendations were made."
    }
    compliance-ctrl: "Compliance Controller" {
      style: { fill: "#438DD5"; stroke: "#2E6295"; font-color: "#ffffff"; font-size: 34; bold: true; border-radius: 14; stroke-width: 3; shadow: true }
      link: layers.c3-compliance-ctrl
      tooltip: "Validates advisory decisions against regulatory and mandate constraints, checking that proposed trades comply with investor mandates, concentration limits, and regulatory requirements before execution."
    }
    decision-workflow-ctrl: "Decision Workflow Controller" {
      style: { fill: "#438DD5"; stroke: "#2E6295"; font-color: "#ffffff"; font-size: 34; bold: true; border-radius: 14; stroke-width: 3; shadow: true }
      link: layers.c3-decision-workflow-ctrl
      tooltip: "Orchestrates the multi-step advisory decision cycle by coordinating parallel AI agents for portfolio analysis, market intelligence, compliance checking, and allocation through a state machine. It aggregates their outputs into a decision packet and learns investor preferences over time."
    }
    investor-profile-ctrl: "Investor Profile Controller" {
      style: { fill: "#438DD5"; stroke: "#2E6295"; font-color: "#ffffff"; font-size: 34; bold: true; border-radius: 14; stroke-width: 3; shadow: true }
      link: layers.c3-investor-profile-ctrl
      tooltip: "Maintains enriched investor profiles for advisory decisions by combining regulatory suitability data with behavioral signals. It builds a comprehensive understanding of each investor's risk tolerance, goals, and preferences."
    }
    market-intelligence-ctrl: "Market Intelligence Controller" {
      style: { fill: "#438DD5"; stroke: "#2E6295"; font-color: "#ffffff"; font-size: 34; bold: true; border-radius: 14; stroke-width: 3; shadow: true }
      link: layers.c3-market-intelligence-ctrl
      tooltip: "Monitors and analyzes market conditions by aggregating signals from multiple data sources including economic indicators, news, filings, and prices. It assesses market sentiment and identifies conditions relevant to portfolio decisions."
    }
    portfolio-engine-ctrl: "Portfolio Engine Controller" {
      style: { fill: "#438DD5"; stroke: "#2E6295"; font-color: "#ffffff"; font-size: 34; bold: true; border-radius: 14; stroke-width: 3; shadow: true }
      link: layers.c3-portfolio-engine-ctrl
      tooltip: "Analyzes portfolio composition and fund characteristics, evaluating holdings against target allocations and screening the investment universe for rebalancing candidates. It provides portfolio analytics to the decision workflow."
    }
    alpha-vantage-adpt: "Alpha Vantage Adapter" {
      style: { fill: "#438DD5"; stroke: "#2E6295"; font-color: "#ffffff"; font-size: 34; bold: true; border-radius: 14; stroke-width: 3; shadow: true }
      link: layers.c3-alpha-vantage-adpt
      tooltip: "Fetches economic indicators and market articles from the Alpha Vantage API on a scheduled basis, normalizing them into domain events for consumption by the market intelligence pipeline."
    }
    fred-adpt: "Fred Adapter" {
      style: { fill: "#438DD5"; stroke: "#2E6295"; font-color: "#ffffff"; font-size: 34; bold: true; border-radius: 14; stroke-width: 3; shadow: true }
      link: layers.c3-fred-adpt
      tooltip: "Fetches Federal Reserve economic data including interest rates, inflation, and employment figures on a scheduled basis, normalizing them into domain events for the market intelligence pipeline."
    }
    marketwatch-adpt: "Marketwatch Adapter" {
      style: { fill: "#438DD5"; stroke: "#2E6295"; font-color: "#ffffff"; font-size: 34; bold: true; border-radius: 14; stroke-width: 3; shadow: true }
      link: layers.c3-marketwatch-adpt
      tooltip: "Ingests market commentary and news summaries, normalizing editorial content into domain events for market sentiment analysis."
    }
    sec-edgar-adpt: "Sec Edgar Adapter" {
      style: { fill: "#438DD5"; stroke: "#2E6295"; font-color: "#ffffff"; font-size: 34; bold: true; border-radius: 14; stroke-width: 3; shadow: true }
