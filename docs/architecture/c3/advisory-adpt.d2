direction: right

title: "Advisory\nADPT\n[Cross-Domain Bridge]" {
  style: { font-size: 40; bold: true; fill: transparent; stroke: transparent }
}

target: "advisory-bus\n[Target]" { class: aws-eventbridge }

advisory-ingress-from-investor: "investor-bus\n[Source]" { class: aws-eventbridge }
advisory-ingress-from-investor-dlq: "DLQ" { class: aws-dlq }
advisory-ingress-from-investor -> target

advisory-ingress-from-execution: "execution-bus\n[Source]" { class: aws-eventbridge }
advisory-ingress-from-execution-dlq: "DLQ" { class: aws-dlq }
advisory-ingress-from-execution -> target

advisory-ingress-from-ledger: "ledger-bus\n[Source]" { class: aws-eventbridge }
advisory-ingress-from-ledger-dlq: "DLQ" { class: aws-dlq }
advisory-ingress-from-ledger -> target

