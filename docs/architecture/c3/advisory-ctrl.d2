direction: down

title: "advisory-ctrl\n[Advisory Aggregate]" {
  style: { font-size: 40; bold: true; fill: transparent; stroke: transparent }
}

ingress: "Ingress" {
  style: { fill: "#FFF8E1"; stroke: "#FFC107"; border-radius: 12; font-size: 28 }

  handler-rule: "EventBridge Rule\n[ADVISORY_* events]" { class: aws-eventbridge }
  handler-sqs: "SQS Queue" { class: aws-sqs }
  handler-fn: "Lambda\n[IngressHandler]" { class: aws-lambda }
  handler-dlq: "DLQ" { class: aws-dlq }

  handler-rule -> handler-sqs -> handler-fn
  handler-sqs -> handler-dlq: "On failure" {style.font-size: 22}
}

state: "State" {
  style: { fill: "#E3F2FD"; stroke: "#2196F3"; border-radius: 12; font-size: 28 }

  table: "DynamoDB Table\n[AdvisoryTable]" { class: aws-dynamodb }
  stream: "DynamoDB Stream\n[CDC]" { class: aws-ddb-stream }

  table -> stream
}

egress: "Egress" {
  style: { fill: "#FBE9E7"; stroke: "#FF5722"; border-radius: 12; font-size: 28 }

  processor: "Lambda\n[StreamProcessor]" { class: aws-lambda }
  bus: "EventBridge\n[advisory-bus]" { class: aws-eventbridge }

  processor -> bus: "Publish events" {style.font-size: 22}
}

facade: "Facade" {
  style: { fill: "#F3E5F5"; stroke: "#9C27B0"; border-radius: 12; font-size: 28 }

  ssm: "SSM Parameters\n[Table ARN, Stream ARN]" { class: aws-ssm }
}

# Flows
ingress.handler-fn -> state.table: "Read/Write" {style.font-size: 22}
state.stream -> egress.processor: "CDC trigger" {style.font-size: 22}
state.table -- facade.ssm: "Exports ARNs"
