direction: down

title: "Investor Profile CTRL\n[AI Agent · RAG]" {
  style: { font-size: 40; bold: true; fill: transparent; stroke: transparent }
}

ingress: "Ingress" {
  style: { fill: "#FFF8E1"; stroke: "#FFC107"; border-radius: 12; font-size: 28 }
  rule: "EventBridge Rule\n[3 events]" { class: aws-eventbridge }
  sqs: "SQS Queue" { class: aws-sqs }
  dlq: "DLQ" { class: aws-dlq }
  handler: "Lambda" { class: aws-lambda }

  rule -> sqs: Subscribe
  sqs -> handler: Invoke
  sqs -> dlq: On failure
}

state: "State" {
  style: { fill: "#E3F2FD"; stroke: "#2196F3"; border-radius: 12; font-size: 28 }
  table: "DynamoDB Table" { class: aws-dynamodb }
  stream: "DynamoDB Stream\n[CDC]" { class: aws-ddb-stream }
  table -> stream: CDC
}

egress: "Egress" {
  style: { fill: "#FBE9E7"; stroke: "#FF5722"; border-radius: 12; font-size: 28 }
  processor: "Lambda" { class: aws-lambda }
  bus: "EventBridge\n[advisory-bus]" { class: aws-eventbridge }
  dlq: "DLQ" { class: aws-dlq }

  processor -> bus: Publish
}

agent-runtime: "AgentRuntime" {
  style: { fill: "#E8F5E9"; stroke: "#4CAF50"; border-radius: 12; font-size: 28 }
  runtime: "Bedrock AgentCore" { class: aws-bedrock }
  gateway: "MCP Gateway" { class: aws-lambda }
  runtime -> gateway
}

knowledge-base: "KnowledgeBase" {
  style: { fill: "#FFF3E0"; stroke: "#FF9800"; border-radius: 12; font-size: 28 }
  kb: "Bedrock Knowledge Base" { class: aws-bedrock }
  s3: "S3 Bucket" { class: aws-s3 }
  s3 -> kb
}

kbingestion: "Lambda\n[KBIngestion]" { class: aws-lambda }

# Flows
ingress.handler -> state.table: Read/Write
state.stream -> egress.processor: Trigger
agent-runtime.runtime -> knowledge-base.kb: RAG Query
agent-runtime.runtime -> state.table: Read/Write
