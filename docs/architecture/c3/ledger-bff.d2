direction: down

title: "Ledger\nBFF\n[GraphQL API]" {
  style: { font-size: 40; bold: true; fill: transparent; stroke: transparent }
}

facade: "Facade" {
  style: { fill: "#F3E5F5"; stroke: "#9C27B0"; border-radius: 12; font-size: 28 }
  appsync: "AppSync API" { class: aws-appsync }
  resolvers: "JS Resolvers" { class: aws-lambda }
  appsync -> resolvers: JS Resolve
  ssm: "SSM Parameters" { class: aws-ssm }
}

ingress: "Ingress" {
  style: { fill: "#FFF8E1"; stroke: "#FFC107"; border-radius: 12; font-size: 28 }
  rule: "EventBridge Rule\n[3 events]" { class: aws-eventbridge }
  sqs: "SQS Queue" { class: aws-sqs }
  dlq: "DLQ" { class: aws-dlq }
  handler: "Lambda" { class: aws-lambda }

  rule -> sqs: Subscribe
  sqs -> handler: Invoke
  sqs -> dlq: On failure
}

state: "State" {
  style: { fill: "#E3F2FD"; stroke: "#2196F3"; border-radius: 12; font-size: 28 }
  table: "DynamoDB Table" { class: aws-dynamodb }
  stream: "DynamoDB Stream\n[CDC]" { class: aws-ddb-stream }
  table -> stream: CDC
}

graphql-resolver: "Lambda\n[GraphqlResolver]" { class: aws-lambda }

mfe-bundle: "MFE Bundle\n[/ledger · via shared CDN]" { class: aws-s3 }

# Flows
facade.resolvers -> state.table: Read/Write
ingress.handler -> state.table: Read/Write
