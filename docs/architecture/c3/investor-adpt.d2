direction: right

title: "Investor Adapter\n[Cross-Domain Bridge]" {
  style: { font-size: 40; bold: true; fill: transparent; stroke: transparent }
}

source: "investor-bus\n[Source]" { class: aws-eventbridge }

to-advisory: "advisory-bus\n[Target]" { class: aws-eventbridge }
to-advisory-dlq: "DLQ" { class: aws-dlq }
source -> to-advisory

to-execution: "execution-bus\n[Target]" { class: aws-eventbridge }
to-execution-dlq: "DLQ" { class: aws-dlq }
source -> to-execution

# Flows
