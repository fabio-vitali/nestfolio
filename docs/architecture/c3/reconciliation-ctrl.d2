direction: down

title: "reconciliation-ctrl\n[Position Reconciliation]" {
  style: { font-size: 40; bold: true; fill: transparent; stroke: transparent }
}

ingress: "Ingress" {
  style: { fill: "#FFF8E1"; stroke: "#FFC107"; border-radius: 12; font-size: 28 }

  reconcile-rule: "EventBridge Rule\n[RECONCILE_TRIGGERED]" { class: aws-eventbridge }
  reconcile-sqs: "SQS Queue" { class: aws-sqs }
  reconcile-fn: "Lambda\n[ReconcileHandler]" { class: aws-lambda }
  reconcile-dlq: "DLQ" { class: aws-dlq }

  reconcile-rule -> reconcile-sqs -> reconcile-fn
  reconcile-sqs -> reconcile-dlq: "On failure" {style.font-size: 22}
}

state: "State" {
  style: { fill: "#E3F2FD"; stroke: "#2196F3"; border-radius: 12; font-size: 28 }

  table: "DynamoDB Table\n[ReconciliationTable]" { class: aws-dynamodb }
  stream: "DynamoDB Stream\n[CDC]" { class: aws-ddb-stream }

  table -> stream
}

egress: "Egress" {
  style: { fill: "#FBE9E7"; stroke: "#FF5722"; border-radius: 12; font-size: 28 }

  processor: "Lambda\n[StreamProcessor]" { class: aws-lambda }
  bus: "EventBridge\n[ledger-bus]" { class: aws-eventbridge }

  processor -> bus: "Publish events" {style.font-size: 22}
}

# Flows
ingress.reconcile-fn -> state.table: "Run reconciliation" {style.font-size: 22}
state.stream -> egress.processor: "CDC trigger" {style.font-size: 22}
