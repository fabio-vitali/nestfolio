direction: down

title: "Broker CTRL\n[State Machine]" {
  style: { font-size: 40; bold: true; fill: transparent; stroke: transparent }
}

mode-ingress: "ModeIngress" {
  style: { fill: "#FFF8E1"; stroke: "#FFC107"; border-radius: 12; font-size: 28 }
  rule: "EventBridge Rule\n[1 events]" { class: aws-eventbridge }
  sqs: "SQS Queue" { class: aws-sqs }
  dlq: "DLQ" { class: aws-dlq }
  handler: "Lambda" { class: aws-lambda }

  rule -> sqs: Subscribe
  sqs -> handler: Invoke
  sqs -> dlq: On failure
}

callback-ingress: "CallbackIngress" {
  style: { fill: "#FFF8E1"; stroke: "#FFC107"; border-radius: 12; font-size: 28 }
  rule: "EventBridge Rule\n[8 events]" { class: aws-eventbridge }
  sqs: "SQS Queue" { class: aws-sqs }
  dlq: "DLQ" { class: aws-dlq }
  handler: "Lambda" { class: aws-lambda }

  rule -> sqs: Subscribe
  sqs -> handler: Invoke
  sqs -> dlq: On failure
}

deposit-withdrawal-ingress: "DepositWithdrawalIngress" {
  style: { fill: "#FFF8E1"; stroke: "#FFC107"; border-radius: 12; font-size: 28 }
  rule: "EventBridge Rule\n[2 events]" { class: aws-eventbridge }
  sqs: "SQS Queue" { class: aws-sqs }
  dlq: "DLQ" { class: aws-dlq }
  handler: "Lambda" { class: aws-lambda }

  rule -> sqs: Subscribe
  sqs -> handler: Invoke
  sqs -> dlq: On failure
}

deposit-withdrawal-normalizer-ingress: "DepositWithdrawalNormalizerIngress" {
  style: { fill: "#FFF8E1"; stroke: "#FFC107"; border-radius: 12; font-size: 28 }
  rule: "EventBridge Rule\n[4 events]" { class: aws-eventbridge }
  sqs: "SQS Queue" { class: aws-sqs }
  dlq: "DLQ" { class: aws-dlq }
  handler: "Lambda" { class: aws-lambda }

  rule -> sqs: Subscribe
  sqs -> handler: Invoke
  sqs -> dlq: On failure
}

state: "State" {
  style: { fill: "#E3F2FD"; stroke: "#2196F3"; border-radius: 12; font-size: 28 }
  table: "DynamoDB Table" { class: aws-dynamodb }
  stream: "DynamoDB Stream\n[CDC]" { class: aws-ddb-stream }
  table -> stream: CDC
}

egress: "Egress" {
  style: { fill: "#FBE9E7"; stroke: "#FF5722"; border-radius: 12; font-size: 28 }
  processor: "Lambda" { class: aws-lambda }
  bus: "EventBridge\n[execution-bus]" { class: aws-eventbridge }
  dlq: "DLQ" { class: aws-dlq }

  processor -> bus: Publish
}

order-state-machine: "Orchestration" {
  style: { fill: "#E8F5E9"; stroke: "#4CAF50"; border-radius: 12; font-size: 28 }
  state-machine: "Step Functions\n[OrderStateMachine]" { class: aws-stepfunctions }
  dlq: "DLQ" { class: aws-dlq }
}

heal-state-machine: "Orchestration" {
  style: { fill: "#E8F5E9"; stroke: "#4CAF50"; border-radius: 12; font-size: 28 }
  state-machine: "Step Functions\n[HealStateMachine]" { class: aws-stepfunctions }
  dlq: "DLQ" { class: aws-dlq }
}

route-order-fn: "Lambda\n[RouteOrderFn]" { class: aws-lambda }
emit-health-check-fn: "Lambda\n[EmitHealthCheckFn]" { class: aws-lambda }

# Flows
mode-ingress.handler -> state.table: Read/Write
callback-ingress.handler -> state.table: Read/Write
deposit-withdrawal-ingress.handler -> state.table: Read/Write
deposit-withdrawal-normalizer-ingress.handler -> state.table: Read/Write
state.stream -> egress.processor: Trigger
mode-ingress.handler -> order-state-machine.state-machine: Execute
order-state-machine.state-machine -> state.table: Read/Write
mode-ingress.handler -> heal-state-machine.state-machine: Execute
heal-state-machine.state-machine -> state.table: Read/Write
