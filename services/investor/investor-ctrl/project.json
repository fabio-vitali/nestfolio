{
  "name": "investor-ctrl",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "services/investor/investor-ctrl/src",
  "projectType": "application",
  "targets": {
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx cdk deploy --app 'npx ts-node -r ./tools/register-paths.js services/investor/investor-ctrl/src/main.ts' --require-approval never -c prefix={args.prefix}"
      }
    },
    "destroy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx cdk destroy --app 'npx ts-node -r ./tools/register-paths.js services/investor/investor-ctrl/src/main.ts' --force -c prefix={args.prefix}"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "options": { "jestConfig": "services/investor/investor-ctrl/jest.config.js" }
    },
    "test-integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/run-jest.mjs services/investor/investor-ctrl/jest.integration.config.js --passWithNoTests",
        "env": { "NODE_OPTIONS": "--experimental-vm-modules" },
        "color": true
      }
    },
    "lint": { "executor": "@nx/eslint:lint" },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p services/investor/investor-ctrl/tsconfig.type-test.json"
      }
    }
  },
  "tags": ["scope:investor", "type:ctrl"]
}
