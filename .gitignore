cdk.out*/
cdk.context.json

# Jest scratch (leaked by `forceExit: true` in nx.json test target — workers
# die before `finally` cleanup runs, leaving haste-map cache + empty mkdtemp
# dirs in cwd. Filed as parking: jest-worker-scratch-leak-on-force-exit).
jest_dx/

